# Copy to .env.local for local dev (never commit .env.local)

# Vercel CLI (deploy from app/: `npm run deploy:vercel` loads this file)
# Create at https://vercel.com/account/tokens
# VERCEL_TOKEN=

# Cloudflare API token for `npm run deploy:production` (Worker deploy before Vercel).
# Create at https://dash.cloudflare.com/profile/api-tokens — use "Edit Cloudflare Workers" or equivalent.
# CLOUDFLARE_API_TOKEN=

# Chat (`POST /api/gemini` uses OpenAI). Required for the dashboard chat:
# OPENAI_API_KEY=sk-...
# Optional: OPENAI_MODEL=gpt-5.4-nano

# Legacy Gemini test script only — not used by the Next app chat route:
# GEMINI_SERVICE_ACCOUNT_JSON=... / GEMINI_API_KEY=...

# Logo.dev — publishable key (pk_…) for portfolio org avatars (https://img.logo.dev). Inlined at build time.
# Without this, avatars show initials. Add in Vercel → Settings → Environment Variables → redeploy.
# NEXT_PUBLIC_LOGO_DEV_PUBLISHABLE_KEY=

# Cloudflare Worker (public GET APIs; no key). Optional — defaults to the shared deployment so `npm run dev` works without env.
# NONPROFIT_WORKER_URL=https://nonprofit-data.logangarcia102.workers.dev
# NEXT_PUBLIC_NONPROFIT_WORKER_URL=https://your-account.workers.dev

# Append up to N orgs from D1 `irs990_xml_returns` (TEOS Form 990 XML) to the dashboard list (same Worker + DB as ProPublica cache).
# PORTFOLIO_IRS990_LIMIT=200
