# Copy to .env.local for local dev (never commit .env.local)

# Vercel CLI (deploy from app/: `npm run deploy:vercel` loads this file)
# Create at https://vercel.com/account/tokens
# VERCEL_TOKEN=

# Gemini for Google Cloud API
GEMINI_API_KEY=your-key-here

# Optional: override model (default: gemini-2.5-flash-preview-04-17)
# GEMINI_MODEL=gemini-2.5-flash-preview-04-17

# Cloudflare Worker cache URL (once deployed)
# NONPROFIT_WORKER_URL=https://nonprofit-data.loganngarcia.workers.dev

# Append up to N orgs from D1 `irs990_xml_returns` (TEOS Form 990 XML) to the dashboard list (same Worker + DB as ProPublica cache).
# PORTFOLIO_IRS990_LIMIT=200
